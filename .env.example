# CycleClub Analytics Configuration

# Application Settings
APP_NAME=CycleClub Analytics
ENV=development
SECRET_KEY=super-secret-key-change-in-production-32-chars!
PORT=8000
FRONTEND_URL=http://localhost:5173
CLUB_TIMEZONE=America/Los_Angeles

# Supabase Authentication & Database
# Database URL: SQLite for local dev or PostgreSQL for Supabase
# Example: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./cycleclub.db
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Strava Integration Configuration
# Set STRAVA_MODE to "real" for live Strava v3 API
STRAVA_MODE=real

# Strava API Credentials (NEVER expose STRAVA_CLIENT_SECRET or Service Role Key to frontend!)
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID_HERE
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET_HERE
STRAVA_REDIRECT_URI=http://localhost:8000/api/auth/strava/callback
STRAVA_VERIFY_TOKEN=YOUR_STRAVA_WEBHOOK_VERIFY_TOKEN_HERE

# Frontend Environment Variables (in frontend/.env)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

